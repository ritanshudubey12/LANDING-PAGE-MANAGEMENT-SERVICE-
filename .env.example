# Copy to .env (git-ignored) and fill in. Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=change_me
INTERNAL_SERVICE_TOKEN=replace_in_secret_manager
DATABASE_URL=postgresql://app_user:change_me@localhost:5441/website_builder

# Optional overrides (defaults shown)
# PORT=4027
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=30000
# AUTH_MODE=bff_internal
# INTEGRATIONS_MODE=stub
# REQUEST_TIMEOUT_MS=5000
# RATE_LIMIT_PER_MINUTE=1000
# RECONCILE_INTERVAL_MS=60000
# LOG_LEVEL=info
